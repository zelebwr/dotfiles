local wezterm = require("wezterm")
local config = wezterm.config_builder()

-- Performance Settings

-- Use OpenGL front-end for low CPU/GPU power draw while keeping rendering smooth
config.front_end = "OpenGL"
config.max_fps = 60
config.animation_fps = 1
config.cursor_blink_ease_in = "Constant"
config.cursor_blink_ease_out = "Constant"

-- Font Settings

config.font_size = 10
config.line_height = 1.2
config.font = wezterm.font("SFMono Nerd Font") 

-- Appearance

config.color_scheme = "Catppuccin Macchiato"
config.command_palette_font = wezterm.font("SFMono Nerd Font")

config.window_decorations = "RESIZE"
config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = false

config.window_background_opacity = 0.85
config.default_cursor_style = 'BlinkingBar'
config.cursor_blink_rate = 800

-- If Windows Environment

if wezterm.target_triple:find("windows") then
  config.default_prog = { "powershell.exe", "-NoLogo" }
else
  config.default_prog = { "/bin/bash", "-l" } -- Default interactive Bash on Fedora[cite: 1]
end

-- OS-specific shell launcher logic
{{ if eq .chezmoi.os "windows" -}}
config.default_prog = { "powershell.exe", "-NoLogo" }
{{ else -}}
config.default_prog = { "/bin/bash", "-l" }
{{ end -}}

-- Keybindings

config.leader = { key = 'Space', mods = 'CTRL', timeout_milliseconds = 1000 }

config.keys = {
    -- --- Konsole Compatibility Shortcuts ---
    { key = 'T', mods = 'CTRL|SHIFT', action = wezterm.action.SpawnTab 'CurrentPaneDomain' },
    { key = 'W', mods = 'CTRL|SHIFT', action = wezterm.action.CloseCurrentTab { confirm = true } },

    -- --- Leader Key Pane Management ---
    { key = '|', mods = 'LEADER|SHIFT', action = wezterm.action.SplitHorizontal { domain = 'CurrentPaneDomain' } },
    { key = '-', mods = 'LEADER',       action = wezterm.action.SplitVertical { domain = 'CurrentPaneDomain' } },
    { key = 'x', mods = 'LEADER',       action = wezterm.action.CloseCurrentPane { confirm = true } },

    -- --- Vim Navigation between Panes ---
    { key = 'h', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection 'Left' },
    { key = 'j', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection 'Down' },
    { key = 'k', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection 'Up' },
    { key = 'l', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection 'Right' },

    -- --- Direct Pane Navigation ---
    { key = 'LeftArrow',  mods = 'CTRL|SHIFT', action = wezterm.action.AdjustPaneSize { 'Left', 2 } },
    { key = 'DownArrow',  mods = 'CTRL|SHIFT', action = wezterm.action.AdjustPaneSize { 'Down', 2 } },
    { key = 'UpArrow',    mods = 'CTRL|SHIFT', action = wezterm.action.AdjustPaneSize { 'Up', 2 } },
    { key = 'RightArrow', mods = 'CTRL|SHIFT', action = wezterm.action.AdjustPaneSize { 'Right', 2 } },

    -- --- Enter Copy Mode (Vim-style selection & scrolling) ---
    -- Leader + [  (Matches tmux copy mode)
    { key = '[', mods = 'LEADER', action = wezterm.action.ActivateCopyMode },

    -- --- Fast Viewport Scrolling without entering Copy Mode ---
    -- Shift + PageUp / PageDown
    { key = 'PageUp',   mods = 'SHIFT', action = wezterm.action.ScrollByPage(-0.5) },
    { key = 'PageDown', mods = 'SHIFT', action = wezterm.action.ScrollByPage(0.5) },

    -- Leader + Up / Down Arrow to scroll line-by-line
    { key = 'UpArrow',   mods = 'LEADER', action = wezterm.action.ScrollByLine(-1) },
    { key = 'DownArrow', mods = 'LEADER', action = wezterm.action.ScrollByLine(1) },
}

return config
